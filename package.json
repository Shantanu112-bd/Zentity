{
  "name": "pramaan-zk",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-Preserving Zero-Knowledge Attribute Verification on MST Blockchain",
  "scripts": {
    "preflight:coral": "tsx scripts/gate0/01-preflight.ts --network mstCoralTestnet",
    "preflight:legacy": "tsx scripts/gate0/01-preflight.ts --network mstLegacyTestnet",
    "preflight:mainnet": "tsx scripts/gate0/01-preflight.ts --network mstMainnet",
    "gate0:local": "tsx scripts/gate0/run-gate0.ts --network local",
    "gate0:coral": "tsx scripts/gate0/run-gate0.ts --network mstCoralTestnet",
    "gate0:legacy": "tsx scripts/gate0/run-gate0.ts --network mstLegacyTestnet --allow-unverified-network",
    "build:circuit": "tsx scripts/pramaan/build-circuit.ts",
    "deploy:local": "hardhat run scripts/pramaan/deploy-registry.ts",
    "deploy:coral": "hardhat run scripts/pramaan/deploy-registry.ts --network mstCoralTestnet",
    "deploy:legacy": "hardhat run scripts/pramaan/deploy-registry.ts --network mstLegacyTestnet",
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,magenta\" \"tsx server/index.ts\" \"vite frontend --port 5173\"",
    "build:frontend": "vite build frontend",
    "server": "tsx server/index.ts",
    "test": "hardhat test tests/*.test.ts"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.18",
    "snarkjs": "^0.7.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "viem": "^2.21.57",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  }
}
