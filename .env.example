# Pramaan-ZK Environment Configuration Example
# Copy this file to .env and fill in values.
# NEVER commit .env or paste private keys into chat!

# Deployer / Relayer private key (0x-prefixed, TESTNET-ONLY for development)
# Funded with tMSTC on legacy testnet or Coral testnet
DEPLOYER_PRIVATE_KEY=

# RPC URLs (Optional overrides)
# MST_LEGACY_TESTNET_RPC=https://testnetrpc.mstblockchain.com
# MST_CORAL_TESTNET_RPC=
# MST_MAINNET_RPC=https://mariorpc.mstblockchain.com

# Server Configuration
PORT=3000
NODE_ENV=development

